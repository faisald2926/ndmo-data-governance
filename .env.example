# Copy to .env and adjust:  cp .env.example .env   (Windows: Copy-Item .env.example .env)

# --- PostgreSQL ---
POSTGRES_USER=ndmo
POSTGRES_PASSWORD=ndmo_pass
POSTGRES_DB=ndmo

# --- Local LLM (Ollama) ---
LLM_MODEL=iKhalid/ALLaM:7b
# auto = use Ollama if reachable, else offline keyword fallback
# ollama = require Ollama ; offline = never call Ollama (rules + keyword only)
LLM_MODE=auto
LLM_CONFIDENCE_THRESHOLD=0.55

# --- efficiency (tuned for an 8 GB GPU like the RTX 3070) ---
OLLAMA_KEEP_ALIVE=10m
LLM_NUM_CTX=2048
LLM_CONCURRENCY=4

# --- smaller machines, minimal quality drop ---
#  <6 GB VRAM : LLM_MODEL=qwen2.5:3b-instruct
#  no GPU     : LLM_MODE=offline
# The app defaults to host-native Ollama (http://host.docker.internal:11434).
# For a containerised Ollama: OLLAMA_BASE_URL=http://ollama:11434

# --- Auth / RBAC (CHANGE THESE before any real use) ---
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# A demo read-only user (viewer / viewer123) is also seeded automatically.
