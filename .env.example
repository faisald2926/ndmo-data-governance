# Copy to .env and adjust as needed:  cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=ndmo
POSTGRES_PASSWORD=ndmo_pass
POSTGRES_DB=ndmo

# --- Local LLM (Ollama) ---
LLM_MODEL=iKhalid/ALLaM:7b
# auto = use Ollama if reachable, else offline keyword fallback
# ollama = require Ollama ; offline = never call Ollama (rules + keyword only)
LLM_MODE=auto
LLM_CONFIDENCE_THRESHOLD=0.55

# --- efficiency (tuned for an 8 GB GPU like the RTX 3070) ---
OLLAMA_KEEP_ALIVE=10m      # keep the model resident between calls
LLM_NUM_CTX=2048           # small context = less VRAM, faster
LLM_CONCURRENCY=4          # parallel classification workers

# --- smaller machines, minimal quality drop ---
#  <6 GB VRAM : LLM_MODEL=qwen2.5:3b-instruct
#  no GPU     : LLM_MODE=offline
# The app already defaults to host-native Ollama (http://host.docker.internal:11434).
# Override here only if your Ollama is elsewhere, e.g. a containerised one:
#  OLLAMA_BASE_URL=http://ollama:11434
